<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear first so the restore graph is exactly these two feeds. Without it,
         machine- and user-level NuGet.Config sources are merged in, and any of them can
         serve a package that matches one of ours and win the restore - the dependency-
         confusion path. A developer's private feed and a CI runner's defaults then also
         resolve different binaries from the same checkout. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Il2CppInterop.ReferenceLibs, needed by csharp/stubs/il2cpp, is published only here. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
