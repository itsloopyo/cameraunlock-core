<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reference-only stub for UnityEngine.UI.dll. Separate from Stubs.UnityEngine on
       purpose: the shipped UnityEngine.dll forwards every engine MODULE type but carries
       no forwarder for the UnityEngine.UI namespace, so uGUI types compiled into
       UnityEngine.dll produce typerefs nothing can resolve at runtime.

       net35 is absent because CameraUnlock.Core.Unity removes CrosshairUtility.cs, its
       only uGUI consumer, on that target. -->

  <PropertyGroup>
    <TargetFrameworks>net472;net48</TargetFrameworks>
    <AssemblyName>UnityEngine.UI</AssemblyName>
    <RootNamespace>UnityEngine.UI</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <IsPackable>false</IsPackable>
    <DebugType>none</DebugType>
    <NoWarn>CS0169;CS0649;CS0067;CS0660;CS0661;CS0108;CS0114</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\UnityUIStubs.cs" />
    <ProjectReference Include="..\UnityEngine\Stubs.UnityEngine.csproj" Private="false" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
