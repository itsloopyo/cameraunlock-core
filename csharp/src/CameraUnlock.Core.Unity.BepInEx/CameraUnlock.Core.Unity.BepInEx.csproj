<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net35 excluded: BepInEx requires .NET 4.x -->
    <TargetFrameworks>net472;net48</TargetFrameworks>
    <AssemblyName>CameraUnlock.Core.Unity.BepInEx</AssemblyName>
    <RootNamespace>CameraUnlock.Core.Unity.BepInEx</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <Authors>CameraUnlock Mods</Authors>
    <Description>BepInEx-specific utilities for CameraUnlock head tracking mods</Description>
  </PropertyGroup>

  <!-- Reference CameraUnlock.Core and CameraUnlock.Core.Unity -->
  <ItemGroup>
    <ProjectReference Include="..\CameraUnlock.Core\CameraUnlock.Core.csproj" />
    <ProjectReference Include="..\CameraUnlock.Core.Unity\CameraUnlock.Core.Unity.csproj" />
  </ItemGroup>

  <!-- BepInEx reference - consuming projects should provide actual DLL -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- With no UnityEnginePath supplied, build against the reference stubs this repo owns.
       The valheim-checkout default this used to carry was also silently BROKEN on net472:
       valheim's generated UnityEngine.dll is net48, so MSBuild dropped the reference as
       too new, and this project only compiled because it picked UnityEngine up
       transitively through CameraUnlock.Core.Unity. -->
  <PropertyGroup Condition="'$(UnityEnginePath)' == ''">
    <UseCameraUnlockUnityStubs>true</UseCameraUnlockUnityStubs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCameraUnlockUnityStubs)' == 'true'">
    <ProjectReference Include="..\..\stubs\UnityEngine\Stubs.UnityEngine.csproj" Private="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Unity references from the game install a consuming project points us at. -->
  <ItemGroup Condition="'$(UseCameraUnlockUnityStubs)' != 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityEnginePath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx.dll itself is still resolved from a sibling valheim checkout when the
       consumer passes no BepInExPath. This repo vendors no BepInEx, so unlike the Unity
       references there is nothing here to point at. -->
  <PropertyGroup Condition="'$(BepInExPath)' == ''">
    <BepInExPath>$(MSBuildThisFileDirectory)..\..\..\..\valheim-headtracking\src\ValheimHeadTracking\libs</BepInExPath>
  </PropertyGroup>
</Project>
