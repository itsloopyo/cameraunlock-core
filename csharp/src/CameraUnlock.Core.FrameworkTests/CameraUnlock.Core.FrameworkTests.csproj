<Project Sdk="Microsoft.NET.Sdk">
  <!-- The xunit suite runs on net8.0 only, so this console runs the file-system
       scenarios and the canonical INI reader, editor, key binding and value codec fixtures on the
       desktop Framework runtimes the library ships for: net35 runs on CLR 2.0, net472 on CLR 4.
       `pixi run test-framework` runs both. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net35;net472</TargetFrameworks>
    <AssemblyName>CameraUnlock.Core.FrameworkTests</AssemblyName>
    <RootNamespace>CameraUnlock.Core.Tests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CameraUnlock.Core.Tests\Config\CheckedFileWriterScenarios.cs" Link="CheckedFileWriterScenarios.cs" />
    <Compile Include="..\CameraUnlock.Core.Tests\Config\CanonicalIniFixtures.cs" Link="CanonicalIniFixtures.cs" />
    <Compile Include="..\CameraUnlock.Core.Tests\Config\IniEditorFixtures.cs" Link="IniEditorFixtures.cs" />
    <Compile Include="..\CameraUnlock.Core.Tests\Input\KeyBindingFixtures.cs" Link="KeyBindingFixtures.cs" />
    <Compile Include="..\CameraUnlock.Core.Tests\Config\ValueCodecFixtures.cs" Link="ValueCodecFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>
</Project>
