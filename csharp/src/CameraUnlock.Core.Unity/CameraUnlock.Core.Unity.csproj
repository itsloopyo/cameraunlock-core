<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net35;net472;net48</TargetFrameworks>
    <AssemblyName>CameraUnlock.Core.Unity</AssemblyName>
    <RootNamespace>CameraUnlock.Core.Unity</RootNamespace>
    <Version>1.0.1</Version>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <Authors>CameraUnlock Mods</Authors>
    <Description>Unity-specific extensions for CameraUnlock head tracking mods</Description>
  </PropertyGroup>

  <!-- Legacy net35 for older Unity games like Obra Dinn -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net35'">
    <DefineConstants>$(DefineConstants);NET35</DefineConstants>
    <!-- Suppress warning about Unity DLL version mismatch - expected when cross-compiling -->
    <MSBuildWarningsAsMessages>MSB3258</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Exclude UnityEngine.UI-dependent files from net35 (not available in older Unity) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <Compile Remove="Utilities\CrosshairUtility.cs" />
  </ItemGroup>

  <!-- Reference CameraUnlock.Core -->
  <ItemGroup>
    <ProjectReference Include="..\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>

  <!-- With no UnityEnginePath supplied, build against the reference stubs this repo owns
       rather than a sibling mod checkout's libs directory. That default was
       gone-home-headtracking's libs, so this repo could not build from a clean clone and
       broke outright the day gone-home's generated UnityEngine.UI.dll stopped carrying
       Image/RawImage/Graphic. A mod still passes UnityEnginePath=<its libs> and gets its
       own game DLLs; nothing below fires then. -->
  <PropertyGroup Condition="'$(UnityEnginePath)' == ''">
    <UseCameraUnlockUnityStubs>true</UseCameraUnlockUnityStubs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCameraUnlockUnityStubs)' == 'true'">
    <!-- PrivateAssets stops the stub flowing transitively into .BepInEx and .Harmony,
         which resolve their own Unity references and would otherwise import a second
         assembly named UnityEngine (CS1704). -->
    <ProjectReference Include="..\..\stubs\UnityEngine\Stubs.UnityEngine.csproj" Private="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\stubs\UnityEngine.UI\Stubs.UnityEngine.UI.csproj" Private="false"
                      PrivateAssets="all" Condition="'$(TargetFramework)' != 'net35'" />
  </ItemGroup>

  <!-- Unity references from the game install a consuming project points us at. -->
  <ItemGroup Condition="'$(UseCameraUnlockUnityStubs)' != 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityEnginePath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Old Unity (pre-2017.3) shipped Input.* inside UnityEngine.dll rather
         than a split InputLegacyModule.dll. Gate on file existence so games
         like Gone Home and Obra Dinn don't emit MSB3245 warnings every
         build while modern Unity titles still pick up the split module. -->
    <Reference Include="UnityEngine.InputLegacyModule"
               Condition="Exists('$(UnityEnginePath)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(UnityEnginePath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- UnityEngine.UI only for modern frameworks (not available/used in net35) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net35' And '$(UseCameraUnlockUnityStubs)' != 'true'">
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityEnginePath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A consuming project that DOES pass UnityEnginePath must pass one that exists. -->
  <Target Name="ValidateUnityEnginePath" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(UseCameraUnlockUnityStubs)' != 'true'">
    <Error Condition="!Exists('$(UnityEnginePath)')" Text="UnityEnginePath '$(UnityEnginePath)' does not exist. Pass it via -p:UnityEnginePath=path/to/unity/dlls" />
  </Target>
</Project>
