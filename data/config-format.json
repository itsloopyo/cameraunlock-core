  "exempt": {
    "beamng-drive-headtracking": "Lua in BeamNG's LuaJIT, with file I/O bound to the game's virtual file system, and a JSON config.",
    "cyberpunk-2077-headtracking": "The config is config.json, read and written by the Lua half under Cyber Engine Tweaks. Core has no JSON reader or editor, and CET's LuaJIT has no FFI, so the Lua half cannot call core.",
    "firewatch-headtracking": "MelonLoader owns the parse and rewrites the whole shared MelonPreferences.cfg at quit, so toggles stay session-only.",
    "fusion-360-headtracking": "Pure Python in Fusion's embedded interpreter, reading its config with configparser.",
    "green-hell-headtracking": "No config: the mod reads no file. A config added later is canonical from the start, with defaults equal to today's hardcoded values.",
    "minecraft-java-edition-headtracking": "Java under Fabric with a .properties config, and it carries its own Java port of core.",
    "ni-no-kuni-wrath-of-the-white-witch-headtracking": "No config: the mod reads nothing. A config added later is canonical from the start, with defaults equal to today's hardcoded values.",
    "outer-wilds-headtracking": "OWML owns the parse and rewrites config.json whole from its menus, and the OWML that runs is the user's, so toggles stay session-only.",
    "the-pathless-headtracking": "Pure Lua under UE4SS with a JSON config, and nothing to persist: its only runtime control is F10, the master toggle."
  },
