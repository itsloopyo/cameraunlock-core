  "normalisations": {
    "N1": {
      "rule": "A legacy hotkey code outside 0x01-0xFE imports as unbound, 0xFF included. Unguarded readers accept such codes: core's IniReader::ReadHex in fallout-4 and titanfall-2 reads -1, abc (0xABC), 1abc and 0x230, skyrim-special-edition reads hotkeys with strtol, and HotkeyPoller::AddHotkey stores any code. The canonical hotkey grammar holds 0x01-0xFE only. A legacy 0xFF hotkey could fire (see probe), so N1 unbinds it for a player who bound one.",
      "approved": "2026-09-25",
      "probe": "pixi run probe-n1 (cameraunlock_tests --probe-getasynckeystate), Windows 11 Pro 10.0.26200, interactive desktop, 2026-09-24: with F24 (0x87) held by SendInput, GetAsyncKeyState reported 0x87 down and reported up for 0x187, 0x287, 0x10087, -121, 0, 0xFF, 0x100 and -1, so no out-of-range code aliases a key in range. With VK 0xFF itself held, GetAsyncKeyState(0xFF) reported down. 0xFF is VK__none_, the code kbd.h gives to scan codes a layout leaves unmapped. A search of every tracked .ini and .cfg in the sibling repos found no key or toggle line holding 0xFF, 255, -1, 0 or 0x0.",
      "drop_rule": "KeyCodeOutOfRange"
    },
    "N2": {
      "rule": "A non-finite float imports as the row's default. IniReader::ReadDouble accepts nan, inf and 1e400, abzu reads its sensitivities and deadzone through it unguarded, and skyrim-special-edition's atof and std::clamp let NaN through, which gives a NaN view matrix every frame. Repos that already sanitise turn a non-finite value into their fallback on read and see no change.",
      "approved": "2026-09-24",
      "drop_rule": "NonFiniteNumber"
    },
    "N3": {
      "rule": "A legacy hotkey bound to a Ctrl, Shift or Alt key on its own imports as unbound, and the drop is logged. That is 0x10-0x12 or 0xA0-0xA5 in a native mod (C++ LegacyVirtualKeyToBindings) and LeftShift, RightShift, LeftControl, RightControl, LeftAlt or RightAlt in a Unity mod (C# LegacyNormalisations.KeyCodeToBindings). Such a key goes down before the key of any chord it starts, so a binding on it fires at the start of every Ctrl+Shift chord, and the canonical hotkey grammar refuses it as a key. Where the import adds the action's Ctrl+Shift chord to the list, the player keeps the chord.",
      "approved": "2026-09-26",
      "drop_rule": "ModifierKey"
    }
  },
  "approved_changes": {
    "reticle": {
      "decision": 2,
      "text": "Mods do not draw their own reticles, so the canonical format and the preference set have no reticle toggle and no ShowReticle concept. A migration drops a legacy reticle toggle hotkey, ShowReticle and reticle colour, and the conversion documents the loss.",
      "approved": "2026-09-24",
      "drop_rule": "Reticle"
    },
    "pose_shaping": {
      "decision": 3,
      "text": "The tracker owns pose shaping, so sensitivity multipliers, deadzones, response curves and user-facing axis inversion leave every mod and the canonical format has no rows for them. A value a player set away from the shipped default is dropped. A shipped default that is not identity (abzu InvertRoll=true, [Position] InvertX=true, a roll multiplier other than 1) was correcting the mod's axis conversion, so the conversion folds it into the mod's boundary code and default behaviour does not change. Unit scales a player can edit (game units per metre of head movement: PositionScale, WorldScale, UnitsPerMeter and the other spellings of schema non_canonical_keys PositionScale) are covered too, by the owner's ruling of 2026-09-25 that axis signs and scales are correct in code: the conversion folds the shipped scale into the mod's code as a constant, and a scale a player changed is dropped like a sensitivity.",
      "approved": "2026-09-24",
      "drop_rule": "PoseShaping"
    },
    "follows_default": {
      "decision": 4,
      "text": "A feature shipped disabled pending verification (CollisionEnabled, for example) takes its intended default in the conversion and follows core's default from then on, instead of keeping the value a legacy file holds.",
      "approved": "2026-09-24",
      "drop_rule": "FollowsDefault"
    }
  },
  "conversion_notes": {
    "resident-evil-requiem-headtracking": [
      {
        "text": "Position sensitivity is 1.0. v0.4.0's installer ZIP and Nexus ZIP ship [Position] SensitivityX/Y/Z=1.0 in HeadTracking.ini; its launcher-manifest seed carried 2.0 from an older file, which was drift and was re-encoded from the shipped file on 2026-08-30 (ac80142). 1.0 is identity, so the conversion folds no position sensitivity into the mod's code, and a file Lopari seeded from v0.4.0 has its 2.0 dropped as PoseShaping, like any value set away from the shipped default. Those players' lean halves.",
        "approved": "2026-09-25"
      }
    ]
  },
  "allow_legacy_symbols": {},
  "per_game": {
    "subnautica-headtracking": [
      {
        "row": "WorldSpaceYaw",
        "reason": "The mod defaults to camera-local yaw because swimming has no stable up, so Defaults.ini's WorldSpaceYaw must not reach it.",
        "approved": "2026-09-25"
      }
    ],
    "trepang2-headtracking": [
      {
        "row": "CycleTrackingModeKey",
        "reason": "The fleet chord clashes with the game's own binding: in Trepang2 Ctrl+Shift+G throws a grenade. The committed file holds CycleTrackingModeKey=PageUp, Ctrl+Shift+J.",
        "approved": "2026-09-26"
      },
      {
        "row": "YawModeKey",
        "reason": "The fleet chord clashes with the game's own binding: in Trepang2 Ctrl+Shift+H dual wields. The committed file holds YawModeKey=PageDown.",
        "approved": "2026-09-26"
      }
    ]
  }
